# IncidentMind Backend — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# AI CONFIGURATION (Optional - smart mock used if blank)
# ============================================
# Get a free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# HINDSIGHT MEMORY CONFIGURATION (Required for Real Cloud Memory)
# ============================================
# Hindsight provides persistent, evolving memory for AI agents (retain, recall, reflect).
# Option 1: Managed Hindsight Cloud
# Sign up at: https://hindsight.vectorize.io or https://usehindsight.com
# Set your API key below (starts with hs_...):
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incident-mind

# Option 2: Self-hosted Hindsight (Docker / Local)
# Run Hindsight locally via Docker: docker run -p 8888:8888 vectorize/hindsight
# HINDSIGHT_API_URL=http://localhost:8888
# HINDSIGHT_API_KEY=

# Option 3: Demo Fallback
# If HINDSIGHT_API_KEY is left blank, IncidentMind operates in
# DEMO FALLBACK MEMORY mode using local JSON persistence.
# The UI will clearly indicate DEMO FALLBACK vs REAL HINDSIGHT MEMORY.

# ============================================
# SERVER CONFIGURATION
# ============================================
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ============================================
# DEMO MODE
# ============================================
# Set to "true" to force deterministic mock AI responses for reliable demos
DEMO_MODE=false
